  "schema": 12,
  "pricing_revision": "2026-10-02-progressive-issuance-v1",
  "mode": "TEST_ONLY",
  "production_ready": false,
  "currency": "JPY",
  "credit_definition": "1 Credit = 1 JPY equivalent",
  "billing_unit_definition": "1000 billing units = 1 Credit",
  "api_pricing_models": {
    "license.issue.v6.submit": {
      "basis": "per request, based on requested key count",
      "production_formula": "2.000 Cr minimum through 200 keys; 0.010 Cr/key from 201–25,000; 0.006 Cr/key from 25,001–50,000; 0.004 Cr/key from 50,001–100,000",
      "sandbox_multiplier": "0.1"
    },
    "license.issue.v7.submit": {
      "basis": "same progressive schedule, 10% discount",
      "max_keys_per_request": 1000,
      "sandbox_multiplier": "0.1"
    },
    "license.issue.v8.submit": {
      "basis": "per request, based on requested key count",
      "production_formula": "2.000 Cr minimum through 200 keys; 0.010 Cr/key from 201–25,000; 0.006 Cr/key from 25,001–50,000; 0.004 Cr/key from 50,001–100,000",
      "sandbox_multiplier": "0.1"
    }
  },
  "v4_speed_surcharge_policy": {
    "fixed_chunk_range_removed": true,
    "default_chunk": "auto_max",
    "effective_chunk_capped_by_job_count": true,
    "max_multiplier": 20.0,
    "tiers": [
      {
        "lane": "Light",
        "max_chunk": 100,
        "multiplier": 1.0,
        "code": "1x"
      },
      {
        "lane": "Middle",
        "max_chunk": 250,
        "multiplier": 1.5,
        "code": "1_5x"
      },
      {
        "lane": "High",
        "max_chunk": 400,
        "multiplier": 2.0,
        "code": "2x"
      },
      {
        "lane": "Max",
        "max_chunk": 500,
        "multiplier": 3.0,
        "code": "3x"
      },
      {
        "lane": "Maxx5",
        "max_chunk": 2500,
        "multiplier": 5.0,
        "code": "5x"
      },
      {
        "lane": "Max10",
        "max_chunk": 5000,
        "multiplier": 10.0,
        "code": "10x"
      },
      {
        "lane": "Max20",
        "max_chunk": null,
        "multiplier": 20.0,
        "code": "20x"
      }
    ]
  },
  "jpki_policy": {
    "mock_available": false,
    "sandbox_uses_real_verification_path": true
  },
  "mnsl_policy": {
    "local_card_read_is_free": true,
    "local_card_artifact_reads_are_free": true,
    "terms_consent_jpki_is_free": true,
    "granular_pipeline_billing": true,
    "local_only_capture_is_free": true,
    "ios_randomizer_billing_unit": "completed_secure_identity_session",
    "ios_randomizer_frames_per_session": 5,
    "ios_randomizer_per_frame_billing": false,
    "ios_randomizer_bundle_includes": [
      "encrypted_transfer",
      "session_protection",
      "anti_replay_and_abuse_controls",
      "audit",
      "random_action_validation"
    ],
    "ios_randomizer_no_automatic_face_liveness_double_charge": true
  },
  "status_policy": {
    "billable_status_min": 200,
