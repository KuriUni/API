nd:#ffffff03;max-width:420px;display:flex;gap:15px;align-items:flex-start}.retry svg{width:20px;height:20px;color:var(--mint);flex:none;margin-top:4px}.retry strong{display:block;font-size:13px;font-weight:550}.retry p{font-size:11px;color:var(--muted);margin:3px 0 0;line-height:1.9}.refresh{display:inline-flex;gap:22px;align-items:center;background:var(--mint);color:#102b25;border:1px solid transparent;border-radius:9px;padding:13px 22px;font-family:inherit;font-weight:600;font-size:13px;line-height:1.5;text-decoration:none;cursor:pointer;transition:background .15s,transform .15s}.refresh:hover{background:#c0f9e1;transform:translateY(-1px)}.refresh:focus-visible{outline:3px solid white;outline-offset:5px}.refresh svg{width:17px;height:17px}.note{color:var(--muted);font-size:11px;margin-top:14px}\n.visual{position:relative;min-height:410px;display:grid;place-items:center;isolation:isolate}.orbit{position:absolute;width:350px;aspect-ratio:1;border:1px solid #a5f3d01c;border-radius:50%;transform:rotate(-25deg)}.orbit:before{content:\"\";position:absolute;inset:28px;border:1px dashed #a5f3d019;border-radius:50%}.orbit:after{content:\"\";position:absolute;width:8px;height:8px;border-radius:50%;background:var(--mint);left:48px;top:47px;box-shadow:0 0 24px #a5f3d066}.halo{position:absolute;width:270px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#a5f3d00c,transparent 70%);z-index:-1}.code{font-size:clamp(110px,15vw,186px);font-weight:250;line-height:1;letter-spacing:-.065em;font-variant-numeric:tabular-nums;color:#c8e7df;transform:translateX(-6px)}.visual-label{position:absolute;bottom:22px;color:#779d9a;font-size:10px;letter-spacing:.28em}.pill{position:absolute;top:48px;right:0;font-size:9px;letter-spacing:.12em;color:#a5f3d0a0;border:1px solid #a5f3d025;border-radius:30px;padding:5px 11px;background:#0c1c23}.footer{justify-content:space-between;gap:15px;border-top:1px solid var(--line);padding-top:20px;color:#738b98;font-size:10px;letter-spacing:.