Options -Indexes +ExecCGI
AcceptPathInfo On
CGIPassAuth On
AddHandler cgi-script .cgi
DirectoryIndex index.html
RewriteEngine On

# Force TLS while remaining compatible with the site's Cloudflare proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteRule ^ https://suna.2415.jp%{REQUEST_URI} [R=301,L,NE]

# Never expose the signing key, rate-limit state, source code or deployment files.
RewriteRule ^\.sunabar(?:/|$) - [F,L,NC]
RewriteRule ^vendor(?:/|$) - [F,L,NC]
<FilesMatch "(?i)^(?:main\.py|README(?:\.md)?|.*\.(?:py|pyc|json|lock|key|log|bak|tmp|zip))$">
    Require all denied
</FilesMatch>

# Map extensionless API paths to the Python CGI entry point.
RewriteRule ^api/v1/(key|products|licenses(?:/(?:list|revoke))?|verify|healthz)/?$ api.cgi/api/v1/$1 [QSA,L,NC]
RewriteRule ^api/v1/(activate|session/(?:check|refresh|deactivate))/?$ api.cgi/api/v1/$1 [QSA,L,NC]

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "frame-ancestors 'none'"
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
